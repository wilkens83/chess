{
  "name": "chess",
  "version": "0.1.0",
  "private": true,
  "description": "A real-time chess server: lobby, live games with server-side clocks, spectating, analysis board and ratings.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch & tsx watch src/server/main.ts",
    "start": "node scripts/build.mjs && tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "engine": "node scripts/install-engine.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "5.9"
  }
}
